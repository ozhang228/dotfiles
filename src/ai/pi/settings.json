{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "drw",
  "defaultModel": "@azure/gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["read", "grep", "find", "ls"],
  "skills": ["!skills/**", "~/dotfiles/src/ai/skills"],
  "prompts": ["!**"],
  "packages": [],
  "extensions": [
    "!**",
    "+builtin:mcp",
    "+builtin:codemode",
    "+builtin:tool-search",
    "+extensions/pi-command-menu/index.ts",
    "+extensions/portkey-provider.ts"
  ],
  "themes": ["!**", "+themes/catppuccin-macchiato.json"],
  "theme": "catppuccin-macchiato",
  "enableSkillCommands": true,
  "tuiMode": "regular",
  "hideThinkingBlock": true,
  "quietStartup": true,
  "doubleEscapeAction": "none",
  "markdown": {
    "mermaid": "streaming"
  },
  "terminal": {
    "showImages": true,
    "images": "auto",
    "showTerminalProgress": false,
    "hyperlinks": "auto"
  },
  "images": {
    "blockImages": false
  },
  "showCacheMissNotices": false,
  "compaction": {
    "enabled": true
  },
  "branchSummary": {
    "skipPrompt": true
  },
  "cacheWarming": "off",
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "maxRetries": 0
    }
  },
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "modelThinkingLevels": {},
  "lastChangelogVersion": "1.5.0"
}
