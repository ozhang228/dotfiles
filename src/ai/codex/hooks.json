{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "env AI_BRANCH_SESSION_DIR=/home/ozhang/.codex/branch-sessions /home/ozhang/dotfiles/src/ai/hooks/ai_desktop_notification.sh track-session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ozhang/dotfiles/src/ai/hooks/tmux_ai_status.sh UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ozhang/dotfiles/src/ai/hooks/tmux_ai_status.sh PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ozhang/dotfiles/src/ai/hooks/tmux_ai_status.sh PermissionRequest",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ozhang/dotfiles/src/ai/hooks/tmux_ai_status.sh Stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env AI_BRANCH_SESSION_DIR=/home/ozhang/.codex/branch-sessions /home/ozhang/dotfiles/src/ai/hooks/ai_desktop_notification.sh track-session",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
