# syntax highlighting variables
# https://fishshell.com/docs/current/interactive.html#syntax-highlighting-variables
fish_color_normal cad3f5
fish_color_command c6a0f6
fish_color_keyword 8bd5ca
fish_color_quote eed49f
fish_color_redirection 8bd5ca
fish_color_end 939ab7
fish_color_error ee99a0
fish_color_param f5a97f
fish_color_comment 939ab7
# fish_color_match --background=brblue
fish_color_selection --reverse
# fish_color_history_current --bold
fish_color_operator cad3f5
fish_color_escape 8bd5ca
fish_color_autosuggestion 939ab7
fish_color_cwd f5a97f
# fish_color_cwd_root red
fish_color_user eed49f
fish_color_host 8bd5ca
fish_color_host_remote c6a0f6
fish_color_cancel cad3f5
fish_color_search_match --background=363a4f
fish_color_valid_path

# pager color variables
# https://fishshell.com/docs/current/interactive.html#pager-color-variables
fish_pager_color_progress f5a97f
fish_pager_color_background --background=363a4f
fish_pager_color_prefix a6da95
fish_pager_color_completion b8c0e0
fish_pager_color_description b8c0e0
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix
fish_pager_color_secondary_completion
fish_pager_color_secondary_description
fish_pager_color_selected_background --background=494d64
fish_pager_color_selected_prefix a6da95
fish_pager_color_selected_completion cad3f5
fish_pager_color_selected_description cad3f5
