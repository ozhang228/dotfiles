[global]
    follow = mouse
    origin = top-right
    offset = 5x5

    width = 900

    progress_bar_min_width = 880
    progress_bar_max_width = 880
    progress_bar_corner_radius = 2

    padding = 10
    horizontal_padding = 10
    frame_width = 1
    gap_size = 3
    font = "JetBrainsMono Nerd Font 14"

    icon_position = off
    corner_radius = 2

    background = "#f9f5d7"
    foreground = "#282828"

    markup = full
    word_wrap = yes

    mouse_left_click = close_current
    mouse_right_click = do_action, close_current

[urgency_low]
    background = "#ebdbb2"
    highlight = "#67630c"
    frame_color = "#67630c"
    default_icon = "dialog-information"
    format = "<b><span foreground='#67630c'>[%a] %s</span></b>\n<span size='13312'>%b</span>"
    timeout = 6

[urgency_normal]
    background = "#ebdbb2"
    highlight = "#82560e"
    frame_color = "#82560e"
    default_icon = "dialog-warning"
    format = "<b><span foreground='#82560e'>[%a] %s</span></b>\n<span size='13312'>%b</span>"
    timeout = 9

[urgency_critical]
    background = "#ebdbb2"
    highlight = "#9d0006"
    frame_color = "#9d0006"
    default_icon = "dialog-error"
    format = "<b><span foreground='#9d0006'>[%a] %s</span></b>\n<span size='13312'>%b</span>"
    timeout = 0

[ai_assistant]
    summary = "AI Assistant"
    script = ~/.config/dunst/play_sound.sh

[ai_assistant_waiting]
    summary = "AI Assistant (waiting)"
    script = ~/.config/dunst/play_sound_permission.sh
